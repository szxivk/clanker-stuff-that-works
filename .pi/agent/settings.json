{
  "lastChangelogVersion": "0.99.2",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@narumitw/pi-btw",
    "npm:@xynogen/pix-optimizer",
    "npm:@pi-kaush/pi-welcome-screen@0.1.3",
    "npm:pi-toggle-skills"
  ],
  "observational-memory": {
    "chunkTokens": 5000,
    "chunkOverlapTokens": 0,
    "poolTargetTokens": 10000,
    "consolidateAtPoolTokens": 20000,
    "compactAtContextTokens": 100000,
    "tailTokens": 20000,
    "journeyTargetTokens": 1000,
    "observerConcurrency": 4,
    "models": {
      "observer": {
        "provider": "openai-codex",
        "id": "gpt-5.6-terra",
        "thinking": "low"
      },
      "consolidator": {
        "provider": "openai-codex",
        "id": "gpt-5.6-terra",
        "thinking": "medium"
      }
    },
    "passive": false,
    "debugLog": false
  },
  "enabledModels": [
    "google/gemini-3.8-flash",
    "google/gemini-flash-latest",
    "google/gemini-flash-lite-latest",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol"
  ],
  "hideThinkingBlock": false
}